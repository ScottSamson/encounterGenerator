{
  "name": "eg-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",

  // eg-web.<subdomain>.workers.dev, plus per-version and aliased preview URLs
  // (stage deploys are aliased "stage": stage-eg-web.<subdomain>.workers.dev).
  "workers_dev": true,
  "preview_urls": true,

  // Static export from `next build` (output: 'export'). Only /api/* runs the Worker; the
  // rest is served from the assets without invoking any script.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }

  // LAMBDA_ORIGIN and the AWS_* secrets are intentionally not set here. web-deploy.yml
  // passes them per environment (`--var` / `--secrets-file`) from the GitHub Environment.
}
